{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "SPECTRA Plan JSON Contract",
  "description": "Machine-readable intermediate representation of plan.md. Generated by plan-extract.sh, consumed by parse_plan() in spectra-loop.sh.",
  "type": "object",
  "required": ["version", "project", "level", "generated", "tasks"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version for forward compatibility",
      "enum": ["1.0"]
    },
    "project": {
      "type": "string",
      "description": "Project name extracted from plan header"
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "description": "Project level (0-4)"
    },
    "generated": {
      "type": "string",
      "description": "Date the plan was generated (YYYY-MM-DD)"
    },
    "source": {
      "type": "string",
      "description": "Source of stories (e.g., '.spectra/stories/', 'BMAD')"
    },
    "tasks": {
      "type": "array",
      "description": "Ordered array of task objects",
      "items": {
        "$ref": "#/definitions/task"
      }
    },
    "parallelism": {
      "type": "object",
      "description": "Parallelism assessment (Level 3+)",
      "properties": {
        "independent": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Task IDs that can run in parallel"
        },
        "sequential": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Ordered chain of dependent task IDs"
          },
          "description": "Dependency chains (e.g., [[\"001\",\"002\"]])"
        },
        "recommendation": {
          "type": "string",
          "enum": ["TEAM_ELIGIBLE", "SEQUENTIAL_ONLY"]
        }
      }
    }
  },
  "definitions": {
    "task": {
      "type": "object",
      "required": ["id", "title", "status", "line_number"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]{3}$",
          "description": "Three-digit zero-padded task ID"
        },
        "title": {
          "type": "string",
          "description": "Task title from ## Task NNN: header"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "complete", "stuck"],
          "description": "Checkbox state: [ ]=pending, [x]=complete, [!]=stuck"
        },
        "risk": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "Normalized to lowercase (Level 1+)"
        },
        "verify": {
          "type": "string",
          "description": "Verification command (extracted from backticks)"
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 5,
          "description": "Max retry iterations"
        },
        "owns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Files this task exclusively owns (Level 3+)"
        },
        "touches": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Files this task modifies but shares (Level 3+)"
        },
        "reads": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Files this task only reads (Level 3+)"
        },
        "deps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Task IDs this task depends on"
        },
        "line_number": {
          "type": "integer",
          "minimum": 0,
          "description": "Line number of checkbox in plan.md (0 if not found)"
        },
        "scope": {
          "type": "string",
          "enum": ["code", "infra", "docs", "config", "multi-repo"],
          "description": "Task scope (Level 2+)"
        },
        "files": {
          "type": "string",
          "description": "Raw Files: field content"
        },
        "ac": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Acceptance criteria list"
        }
      }
    }
  }
}
