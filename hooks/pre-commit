#!/usr/bin/env bash
# SPECTRA pre-commit hook — wiring proof gate (task-scoped)
# Evaluates assertions for completed [x] and stuck [!] tasks only.
# Current task assertions are checked by spectra-loop.sh post-build via --task NNN.
#
# Installed as symlink: .git/hooks/pre-commit -> ~/.spectra/hooks/pre-commit
# BASH_SOURCE resolves to the symlink path (.git/hooks/), not the target,
# so we resolve via readlink or fall back to ~/.spectra.
set -euo pipefail

# Resolve SPECTRA_HOME: follow symlink to real location, or fall back to ~/.spectra
if [[ -z "${SPECTRA_HOME:-}" ]]; then
    SOURCE="${BASH_SOURCE[0]}"
    if command -v readlink >/dev/null 2>&1 && [[ -L "$SOURCE" ]]; then
        SOURCE="$(readlink -f "$SOURCE")"
    fi
    SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
    SPECTRA_HOME="$(dirname "${SCRIPT_DIR}")"
fi

VERIFIER="${SPECTRA_HOME}/bin/spectra-verify-wiring.sh"
if [[ ! -x "${VERIFIER}" ]]; then
    echo "SPECTRA pre-commit: verifier not found at ${VERIFIER}" >&2
    exit 1
fi

# No --task flag = completed-tasks-only mode (regression guard)
exec "${VERIFIER}" .
